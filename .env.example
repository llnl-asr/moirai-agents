# Copy to .env (chmod 600). .env is gitignored: never commit it.

# ---- models: every chat runs Claude Code; users choose LivAI, Anthropic or OpenAI in Model settings ----
LIVAI_API_KEY=sk-...
ANTHROPIC_BASE_URL=https://livai-api.llnl.gov
MOIRAI_AGENTS_MODEL=claude-sonnet-4.5
MOIRAI_AGENTS_MODELS=claude-sonnet-4.5,gpt-5.5,gpt-5.6-sol,gpt-5.4

# ---- moirai: a Python with moirai and dftracer-utils installed (the capabilities run it, this package never imports it) ----
MOIRAI_AGENTS_MOIRAI_PYTHON=/path/to/venv/bin/python

# ---- web UI ----
# MOIRAI_AGENTS_WEBUI_PORT=8766
# MOIRAI_AGENTS_WEBUI_HOST=127.0.0.1
# MOIRAI_AGENTS_WEBUI_IDLE_S=7200
# MOIRAI_AGENTS_WEBUI_MAX_S=43200
